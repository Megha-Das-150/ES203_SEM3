#include <iostream>
#include <string>
using namespace std;

int main() {
    int n, rev = 0, temp;
    string s, r = "";

    cout << "Enter number: ";
    cin >> n;
    temp = n;

    while (temp > 0) {
        rev = rev * 10 + temp % 10;
        temp /= 10;
    }

    if (n == rev)
        cout << "Number is Palindrome\n";
    else
        cout << "Number is not Palindrome\n";

    cout << "Enter string: ";
    cin >> s;

    for (int i = s.length() - 1; i >= 0; i--)
        r += s[i];

    if (s == r)
        cout << "String is Palindrome";
    else
        cout << "String is not Palindrome";

    return 0;
}
