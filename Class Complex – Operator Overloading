#include <iostream>
using namespace std;

class Complex {
    int r, i;

public:
    Complex(int a=0, int b=0) {
        r=a; i=b;
    }

    Complex operator+(Complex c) {
        return Complex(r+c.r, i+c.i);
    }

    Complex operator-(Complex c) {
        return Complex(r-c.r, i-c.i);
    }

    Complex operator++() {
        ++r; ++i;
        return *this;
    }

    Complex operator--() {
        --r; --i;
        return *this;
    }

    void display() {
        cout << r << "+" << i << "i\n";
    }
};

int main() {
    Complex a(5,3), b(2,1), c;

    c=a+b;
    cout << "Addition: ";
    c.display();

    c=a-b;
    cout << "Subtraction: ";
    c.display();

    ++a;
    cout << "Increment: ";
    a.display();

    --a;
    cout << "Decrement: ";
    a.display();

    return 0;
}
