#include <iostream>
using namespace std;

class B;

class A {
    int x;

public:
    A(int a) { x=a; }
    friend void swap(A &, B &);
};

class B {
    int y;

public:
    B(int b) { y=b; }
    friend void swap(A &, B &);
};

void swap(A &a, B &b) {
    int t=a.x;
    a.x=b.y;
    b.y=t;
}

int main() {
    A a(10);
    B b(20);

    swap(a,b);

    cout << "Numbers swapped successfully";

    return 0;
}
